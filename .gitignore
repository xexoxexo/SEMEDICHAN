# .gitignore untuk SeMediChain

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.spec.bak

# Virtual Environment
venv/
.env.example
.env.production.example
.env
.venv/
env/
ENV/
 
# Data & Secrets (JANGAN COMMIT!)
data/*.db
data/.master_key
data/*.log
data/mail_outbox.log

# IDE & Editor
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Docker (local development)
.dockerignore

# Logs
logs/
*.log

# Test cache
.pytest_cache/

# Development files (Jangan commit ke main)
requirements-dev.txt
.env
.env.*
*.log

# Temporary files
tmp/
*.tmp
*.temp
